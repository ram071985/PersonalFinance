@rendermode InteractiveServer

<!-- Mobile header -->
<header class="fixed top-0 left-0 right-0 z-50 flex h-14 items-center gap-3 border-b border-border bg-surface px-4 lg:hidden">
    <button type="button" class="p-2 text-text hover:text-primary" @onclick="Toggle">
        <span class="bi bi-list text-xl"></span>
    </button>
    <span class="font-semibold text-text">Personal Finance</span>
</header>

<!-- Sidebar -->
<aside class="@(_isOpen ? "translate-x-0" : "-translate-x-full") fixed inset-y-0 left-0 z-40 flex w-64 flex-col border-r border-border bg-surface transition-transform duration-250 lg:static lg:translate-x-0">
    <div class="hidden border-b border-border px-5 py-4 lg:block">
        <a href="" class="text-base font-bold text-text no-underline">Personal Finance</a>
    </div>

    <NavMenu OnNavigate="Close" />
</aside>

<!-- Overlay -->
@if (_isOpen)
{
    <div class="fixed inset-0 z-30 bg-black/55 lg:hidden" @onclick="Close"></div>
}

@code {
    private bool _isOpen;

    private void Toggle() => _isOpen = !_isOpen;
    private void Close() => _isOpen = false;
}