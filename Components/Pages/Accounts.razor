@page "/accounts"
@rendermode InteractiveServer
@namespace PersonalFinance.Components.Pages

<PageTitle>Accounts</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-text">Accounts</h1>
    @if (!_isLoading && !_showForm)
    {
        <button class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-hover"
                @onclick="ShowCreateForm">
            Add Account
        </button>
    }
</div>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading accounts…" />
}
else
{
    @* form goes here later *@

    <div class="overflow-hidden rounded-xl border border-border bg-surface">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-surface-2 text-xs uppercase tracking-wider text-text-muted">
                    <tr>
                        <th class="px-5 py-3">Name</th>
                        <th class="px-5 py-3">Type</th>
                        <th class="hidden px-5 py-3 md:table-cell">Institution</th>
                        <th class="px-5 py-3 text-right">Balance</th>
                        <th class="px-5 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _accounts)
                    {
                        <tr class="border-t border-border hover:bg-surface-2">
                            <td class="px-5 py-3.5 font-medium">@account.Name</td>
                            <td class="px-5 py-3.5">@account.Type</td>
                            <td class="hidden px-5 py-3.5 md:table-cell">@(account.Institution ?? "—")</td>
                            <td class="px-5 py-3.5 text-right font-mono @(account.Balance < 0 ? "text-primary" : "")">
                                @account.Balance.ToString("C")
                            </td>
                            <td class="px-5 py-3.5 text-right">
                                <div class="flex flex-col gap-1.5 sm:flex-row sm:justify-end sm:gap-2">
                                    <button class="rounded-md border border-border px-3 py-1.5 text-xs text-text-muted hover:bg-surface-2 hover:text-text"
                                            @onclick="() => ShowEditForm(account)">
                                        Edit
                                    </button>
                                    <button class="rounded-md border border-primary px-3 py-1.5 text-xs text-primary hover:bg-primary hover:text-white"
                                            @onclick="() => Delete(account.Id)">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}