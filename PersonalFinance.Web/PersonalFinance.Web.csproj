<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>PersonalFinance.Web</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <!-- Do NOT pin Microsoft.AspNetCore.* packages — they must match the App Service runtime.
             Pinning 10.0.10 against a 10.0.9 runtime causes BadImageFormatException on CascadingAuthentication. -->
        <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
        <PackageReference Include="Azure.Identity" Version="1.14.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PersonalFinance.Core\PersonalFinance.Core.csproj" />
    </ItemGroup>

</Project>
