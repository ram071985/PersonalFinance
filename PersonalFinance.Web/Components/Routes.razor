@using Microsoft.AspNetCore.Components.Authorization

@* Cascading auth comes from Program.cs AddCascadingAuthenticationState() — do not wrap again *@
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <p class="content">You are not authorized to access this resource.</p>
                }
            </NotAuthorized>
            <Authorizing>
                <p class="content">Loading…</p>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="[data-focus-on-nav]" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <p class="content">Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>