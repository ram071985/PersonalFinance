@using PersonalFinance.Core.Dtos.Categories
@using PersonalFinance.Web.Models

<div class="mb-6 rounded-xl border border-border bg-surface p-6">
    <h2 class="mb-5 text-lg font-semibold text-foreground">
        @(Model.Id is null ? "New Budget" : "Edit Budget")
    </h2>

    @if (Categories.Count == 0)
    {
        <p class="text-sm text-foreground-muted">
            Create an expense category first, then set a budget for it.
        </p>
        <div class="mt-6">
            <button type="button" class="page-action-btn-secondary" @onclick="OnCancel">Cancel</button>
        </div>
    }
    else
    {
        <EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted" for="budget-category">Category</label>
                    <select id="budget-category"
                            class="pf-select pf-select-block"
                            value="@Model.CategoryId"
                            @onchange="OnCategoryChanged">
                        @foreach (var c in Categories)
                        {
                            <option value="@c.Id">@c.Icon @c.Name</option>
                        }
                    </select>
                    <ValidationMessage For="() => Model.CategoryId" class="field-error" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Amount</label>
                    <MoneyInput @bind-Value="Model.Amount" />
                    <ValidationMessage For="() => Model.Amount" class="field-error" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Year</label>
                    <InputNumber @bind-Value="Model.Year"
                                 class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Month</label>
                    <InputNumber @bind-Value="Model.Month"
                                 class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
                </div>
                <div class="sm:col-span-2">
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Notes</label>
                    <InputText @bind-Value="Model.Notes"
                               class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="mt-3 text-sm text-brand">@Model.ErrorMessage</p>
            }

            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                <button type="submit" class="page-action-btn" disabled="@Model.IsSaving">
                    @(Model.IsSaving ? "Saving…" : "Save")
                </button>
                <button type="button" class="page-action-btn-secondary" @onclick="OnCancel" disabled="@Model.IsSaving">
                    Cancel
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter, EditorRequired] public BudgetFormModel Model { get; set; } = new();
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public EventCallback<BudgetFormModel> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            Model.CategoryId = id;
    }

    private async Task HandleValidSubmit() => await OnSave.InvokeAsync(Model);
}