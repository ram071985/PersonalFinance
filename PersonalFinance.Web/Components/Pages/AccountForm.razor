@using PersonalFinance.Web.Models

<div class="mb-6 rounded-xl border border-border bg-surface p-6">
    <h2 class="mb-5 text-lg font-semibold text-foreground">
        @(Model.Id is null ? "New Account" : "Edit Account")
    </h2>

    <EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Name</label>
                <InputText @bind-Value="Model.Name"
                           class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
                <ValidationMessage For="() => Model.Name" class="field-error" />
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Type</label>
                <InputSelect @bind-Value="Model.Type"
                             class="pf-select pf-select-block">
                    @foreach (var t in EnumOptions.AccountTypes)
                    {
                        <option value="@t.Value">@t.Name</option>
                    }
                </InputSelect>
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Balance</label>
                <InputNumber @bind-Value="Model.Balance" step="0.01"
                             class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Institution</label>
                <InputText @bind-Value="Model.Institution"
                           class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </div>

            <div class="sm:col-span-2">
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Notes</label>
                <InputTextArea @bind-Value="Model.Notes" rows="2"
                               class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="mt-3 text-sm text-brand">@Model.ErrorMessage</p>
        }

        <div class="mt-6 flex gap-3">
            <button type="submit" class="page-action-btn" disabled="@Model.IsSaving">
                @(Model.IsSaving ? "Saving…" : "Save")
            </button>
            <button type="button" class="page-action-btn-secondary" @onclick="OnCancel" disabled="@Model.IsSaving">
                Cancel
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired] public AccountFormModel Model { get; set; } = new();
    [Parameter] public EventCallback<AccountFormModel> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleValidSubmit() => await OnSave.InvokeAsync(Model);
}