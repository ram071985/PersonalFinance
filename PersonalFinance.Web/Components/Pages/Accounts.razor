@page "/accounts"
@using PersonalFinance.Core.Dtos
@using PersonalFinance.Core.Enums
@using PersonalFinance.Web.Models
@using PersonalFinance.Web.Services
@inject FinanceApiClient Api
@rendermode InteractiveServer

<PageTitle>Accounts</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-foreground">Accounts</h1>
    @if (!_isLoading && !_showForm)
    {
        <button class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-hover"
                @onclick="ShowCreateForm">
            Add Account
        </button>
    }
</div>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading accounts…" />
}
else
{
    @if (_showForm)
    {
        <AccountForm Model="_formModel"
                     OnSave="HandleSaveAsync"
                     OnCancel="HideForm" />
    }

    <div class="overflow-hidden rounded-xl border border-border bg-surface">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-surface-2 text-xs uppercase tracking-wider text-foreground-muted">
                    <tr>
                        <th class="px-5 py-3">Name</th>
                        <th class="px-5 py-3">Type</th>
                        <th class="hidden px-5 py-3 md:table-cell">Institution</th>
                        <th class="px-5 py-3 text-right">Balance</th>
                        <th class="px-5 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-5 py-8 text-center text-foreground-muted">
                                No accounts yet. Create one to get started.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in _accounts)
                        {
                            <tr class="border-t border-border hover:bg-surface-2">
                                <td class="px-5 py-3.5 font-medium">@account.Name</td>
                                <td class="px-5 py-3.5">@account.Type</td>
                                <td class="hidden px-5 py-3.5 md:table-cell">@(account.Institution ?? "—")</td>
                                <td class="px-5 py-3.5 text-right font-mono @(account.Balance < 0 ? "text-brand" : "")">
                                    @account.Balance.ToString("C")
                                </td>
                                <td class="px-5 py-3.5 text-right">
                                    <div class="flex flex-col gap-1.5 sm:flex-row sm:justify-end sm:gap-2">
                                        <button class="rounded-md border border-border px-3 py-1.5 text-xs text-foreground-muted hover:bg-surface-2 hover:text-foreground"
                                                @onclick="() => ShowEditForm(account)">
                                            Edit
                                        </button>
                                        <button class="rounded-md border border-brand px-3 py-1.5 text-xs text-brand hover:bg-brand hover:text-white"
                                                @onclick="() => DeleteAsync(account.Id)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

