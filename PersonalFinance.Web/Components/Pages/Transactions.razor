@using PersonalFinance.Web.Helpers
@page "/transactions"
@attribute [Authorize]
@using PersonalFinance.Core.Enums
<PageTitle>Transactions</PageTitle>

<div class="page-toolbar">
    <h1>Transactions</h1>
    @if (!_isLoading && !_showForm)
    {
        <div class="page-toolbar-actions">
            <select @bind="_typeFilter" class="pf-select" aria-label="Type filter">
                <option value="">All types</option>
                <option value="Income">Income</option>
                <option value="Expense">Expense</option>
                <option value="Transfer">Transfers</option>
            </select>
            <button type="button" class="page-action-btn-secondary" @onclick="ExportCsvAsync">
                Export CSV
            </button>
            <button type="button" class="page-action-btn" @onclick="ShowCreateForm">
                Add Transaction
            </button>
        </div>
    }
</div>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading transactions…" />
}
else
{
    @if (_showForm)
    {
        <TransactionsForm Model="_formModel"
                         Accounts="_accounts"
                         Categories="_categories"
                         OnSave="HandleSaveAsync"
                         OnCancel="HideForm"/>
    }

    @if (!FilteredTransactions.Any())
    {
        <div class="rounded-xl border border-border bg-surface p-8">
            <EmptyState Icon="💸" Title="No transactions" Message="Adjust the filter or add one." />
        </div>
    }
    else
    {
        <div class="txn-cards">
            @foreach (var tx in FilteredTransactions)
            {
                <article class="txn-card">
                    <div class="txn-card-main">
                        <div class="txn-card-copy">
                            <h2 class="txn-card-title">@tx.Description</h2>
                            <p class="txn-card-meta">
                                <span>@tx.Date.ToString("MMM d, yyyy")</span>
                                <span class="txn-dot">·</span>
                                <span>@tx.Type</span>
                                @if (!string.IsNullOrEmpty(tx.CategoryName))
                                {
                                    <span class="txn-dot">·</span>
                                    <span>@tx.CategoryIcon @tx.CategoryName</span>
                                }
                            </p>
                        </div>
                        <p class="txn-card-amount @(tx.Type == TransactionType.Income ? "is-income" : "is-expense")">
                            @(tx.Type == TransactionType.Income ? "+" : "−")@tx.Amount.FormatCurrency()
                        </p>
                    </div>
                    <div class="txn-card-actions">
                        <button type="button" class="txn-btn" @onclick="() => ShowEditForm(tx)">Edit</button>
                        <button type="button" class="txn-btn txn-btn-danger" @onclick="() => DeleteAsync(tx.Id)">Delete</button>
                    </div>
                </article>
            }
        </div>

        <div class="txn-table-wrap">
            <table class="txn-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Account</th>
                        <th class="txn-col-category">Category</th>
                        <th>Type</th>
                        <th class="txn-num">Amount</th>
                        <th class="txn-num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in FilteredTransactions)
                    {
                        <tr>
                            <td class="txn-nowrap">@tx.Date.ToString("MMM d, yyyy")</td>
                            <td>@tx.Description</td>
                            <td>@(string.IsNullOrEmpty(tx.AccountName) ? "—" : tx.AccountName)</td>
                            <td class="txn-col-category">
                                @if (!string.IsNullOrEmpty(tx.CategoryName))
                                {
                                    <span>@tx.CategoryIcon @tx.CategoryName</span>
                                }
                                else
                                {
                                    <span class="txn-muted">—</span>
                                }
                            </td>
                            <td>@tx.Type</td>
                            <td class="txn-num @(tx.Type == TransactionType.Income ? "is-income" : "is-expense")">
                                @(tx.Type == TransactionType.Income ? "+" : "−")@tx.Amount.FormatCurrency()
                            </td>
                            <td class="txn-num">
                                <div class="txn-card-actions txn-card-actions-inline">
                                    <button type="button" class="txn-btn" @onclick="() => ShowEditForm(tx)">Edit</button>
                                    <button type="button" class="txn-btn txn-btn-danger" @onclick="() => DeleteAsync(tx.Id)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_totalCount > 0)
        {
            <nav class="txn-pager" aria-label="Transaction pages">
                <button type="button" class="txn-btn" disabled="@(_page <= 1 || _isLoading)"
                        @onclick="() => GoToPageAsync(_page - 1)">Previous</button>
                <p class="txn-pager-status">
                    Page @_page of @_totalPages
                    <span class="txn-pager-count">· @_totalCount total</span>
                </p>
                <button type="button" class="txn-btn" disabled="@(_page >= _totalPages || _isLoading)"
                        @onclick="() => GoToPageAsync(_page + 1)">Next</button>
            </nav>
        }
    }
}