@using PersonalFinance.Core.Dtos.Accounts
@using PersonalFinance.Core.Dtos.Categories
@using PersonalFinance.Core.Enums
@using PersonalFinance.Web.Models

<div class="mb-6 rounded-xl border border-border bg-surface p-6">
    <h2 class="mb-5 text-lg font-semibold text-foreground">
        @(Model.Id is null ? "New Transaction" : "Edit Transaction")
    </h2>

    <EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Date</label>
                <InputDate @bind-Value="Model.Date"
                           class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Type</label>
                <select class="pf-select pf-select-block"
                        value="@((int)Model.Type)"
                        @onchange="OnTypeChanged">
                    @foreach (var t in EnumOptions.TransactionTypes)
                    {
                        <option value="@t.Value">@t.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Account</label>
                <InputSelect @bind-Value="Model.AccountId"
                             class="pf-select pf-select-block">
                    <option value="0">Select account…</option>
                    @foreach (var a in Accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.AccountId" class="field-error" />
            </div>
            @if (Model.Type is TransactionType.Income or TransactionType.Expense)
            {
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Category</label>
                    <select class="pf-select pf-select-block"
                            value="@(Model.CategoryId?.ToString() ?? "")"
                            @onchange="OnCategoryChanged">
                        <option value="">Select category…</option>
                        @foreach (var c in FilteredCategories)
                        {
                            <option value="@c.Id">@c.Icon @c.Name</option>
                        }
                    </select>
                </div>
            }
            <div>
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Amount</label>
                <MoneyInput @bind-Value="Model.Amount" />
                <ValidationMessage For="() => Model.Amount" class="field-error" />
            </div>
            @if (Model.Type == TransactionType.Transfer)
            {
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Transfer To</label>
                    <select class="pf-select pf-select-block"
                            value="@(Model.TransferToAccountId?.ToString() ?? "")"
                            @onchange="OnTransferToChanged">
                        <option value="">Select account…</option>
                        @foreach (var a in Accounts.Where(x => x.Id != Model.AccountId))
                        {
                            <option value="@a.Id">@a.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="sm:col-span-2">
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Description</label>
                <InputText @bind-Value="Model.Description"
                           class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
                <ValidationMessage For="() => Model.Description" class="field-error" />
            </div>
            <div class="sm:col-span-2">
                <label class="mb-1.5 block text-sm font-medium text-foreground-muted">Notes</label>
                <InputTextArea @bind-Value="Model.Notes" rows="2"
                               class="w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-foreground focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="mt-3 text-sm text-brand">@Model.ErrorMessage</p>
        }

        <div class="mt-6 flex gap-3">
            <button type="submit" class="page-action-btn" disabled="@Model.IsSaving">
                @(Model.IsSaving ? "Saving…" : "Save")
            </button>
            <button type="button" class="page-action-btn-secondary" @onclick="OnCancel" disabled="@Model.IsSaving">
                Cancel
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired] public TransactionFormModel Model { get; set; } = new();
    [Parameter] public List<AccountDto> Accounts { get; set; } = new();
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public EventCallback<TransactionFormModel> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private IEnumerable<CategoryDto> FilteredCategories
    {
        get
        {
            var source = Model.Type switch
            {
                TransactionType.Income => Categories.Where(c => c.Type == CategoryType.Income),
                TransactionType.Expense => Categories.Where(c => c.Type == CategoryType.Expense),
                _ => Enumerable.Empty<CategoryDto>()
            };
            // One row per name (guards against historical seed duplicates)
            return source
                .GroupBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.OrderBy(c => c.Id).First())
                .OrderBy(c => c.Name);
        }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && Enum.IsDefined(typeof(TransactionType), v))
            Model.Type = (TransactionType)v;
        Model.CategoryId = null;
        Model.TransferToAccountId = null;
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Model.CategoryId = int.TryParse(raw, out var id) && id > 0 ? id : null;
    }

    private void OnTransferToChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Model.TransferToAccountId = int.TryParse(raw, out var id) && id > 0 ? id : null;
    }

    private async Task HandleValidSubmit()
    {
        if (Model.CategoryId is <= 0) Model.CategoryId = null;
        if (Model.TransferToAccountId is <= 0) Model.TransferToAccountId = null;

        if (Model.Type is TransactionType.Income or TransactionType.Expense)
        {
            if (Model.CategoryId is null)
            {
                Model.ErrorMessage = "Category is required for income and expense.";
                return;
            }
        }

        if (Model.Type == TransactionType.Transfer && Model.TransferToAccountId is null)
        {
            Model.ErrorMessage = "Select a destination account for the transfer.";
            return;
        }

        if (Model.Amount <= 0)
        {
            Model.ErrorMessage = "Amount must be greater than zero.";
            return;
        }

        Model.ErrorMessage = null;
        await OnSave.InvokeAsync(Model);
    }
}