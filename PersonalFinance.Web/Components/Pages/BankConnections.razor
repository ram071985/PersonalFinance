@page "/bank-connections"
@attribute [Authorize]
@using PersonalFinance.Core.Dtos.Plaid
@using PersonalFinance.Web.Services
@using Microsoft.JSInterop
@inject FinanceApiClient Api
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime Js
<PageTitle>Bank connections</PageTitle>

<div class="page-toolbar">
    <h1>Bank connections</h1>
    <div class="page-toolbar-actions">
        <button type="button" class="page-action-btn-secondary" disabled="@_busy" @onclick="SyncAllAsync">
            Sync all
        </button>
        <button type="button" class="page-action-btn" disabled="@_busy" @onclick="ConnectAsync">
            Connect bank
        </button>
    </div>
</div>

<p class="page-lede">
    Connect a bank once. We keep an encrypted token so you are not asked to sign in to Chase every time.
    After a successful link, save it below so accounts and transactions appear here.
</p>

@if (_hasPending)
{
    <section class="bank-pending" aria-label="Finish bank connection">
        <h2 class="bank-pending-title">Finish bank connection</h2>
        <p class="bank-pending-copy">
            Plaid approved this bank. It is not in your app until you save it.
            Stay on this tab, then tap Save connection.
        </p>
        <button type="button"
                class="page-action-btn bank-pending-btn"
                disabled="@_busy"
                @onclick="FinishPendingAsync">
            Save connection
        </button>
    </section>
}

@if (_loading)
{
    <LoadingSpinner Message="Loading connections…" />
}
else if (_items.Count == 0)
{
    <div class="rounded-xl border border-border bg-surface p-8">
        <EmptyState Icon="🏦" Title="No banks linked" Message="Connect Chase or another bank to import transactions automatically." />
    </div>
}
else
{
    <div class="space-y-3">
        @foreach (var item in _items)
        {
            <div class="rounded-xl border border-border bg-surface p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <p class="font-semibold text-foreground">@(item.InstitutionName ?? "Institution")</p>
                        <p class="mt-1 text-xs text-foreground-muted">
                            Status: @item.Status
                            @if (item.LastSyncedAt is not null)
                            {
                                <span> · Last sync @item.LastSyncedAt.Value.ToLocalTime().ToString("g")</span>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(item.LastError))
                        {
                            <p class="mt-1 text-xs text-brand">@item.LastError</p>
                        }
                    </div>
                    <div class="flex gap-2">
                        <button type="button" class="page-action-btn-secondary text-xs" disabled="@_busy"
                                @onclick="() => SyncOneAsync(item.Id)">Sync</button>
                        <button type="button" class="rounded-lg border border-brand px-3 py-2 text-xs text-brand hover:bg-brand hover:text-white"
                                disabled="@_busy" @onclick="() => RemoveAsync(item.Id)">Disconnect</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PlaidItemDto> _items = new();
    private bool _loading = true;
    private bool _busy;

    private bool _hasPending;
    private bool _pendingChecked;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("sessionStorage.getItem", "pf.plaid.pending");
            var has = !string.IsNullOrWhiteSpace(raw);
            if (has != _hasPending)
            {
                _hasPending = has;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task FinishPendingAsync()
    {
        _busy = true;
        try
        {
            var raw = await Js.InvokeAsync<string?>("sessionStorage.getItem", "pf.plaid.pending");
            if (string.IsNullOrWhiteSpace(raw))
            {
                await Toasts.ErrorAsync("No pending bank link in this tab. Use Connect bank, or stay in the same tab after Chase.");
                return;
            }

            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            string? token = null;
            foreach (var name in new[] { "publicToken", "PublicToken", "public_token" })
            {
                if (root.TryGetProperty(name, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    token = p.GetString();
                    if (!string.IsNullOrWhiteSpace(token)) break;
                }
            }

            if (string.IsNullOrWhiteSpace(token))
            {
                await Toasts.ErrorAsync("The pending bank link is invalid. Connect bank again.");
                return;
            }

            string? instId = null;
            string? instName = null;
            foreach (var name in new[] { "institutionId", "InstitutionId" })
                if (root.TryGetProperty(name, out var p)) instId = p.GetString();
            foreach (var name in new[] { "institutionName", "InstitutionName" })
                if (root.TryGetProperty(name, out var p)) instName = p.GetString();

            await Api.ExchangePlaidTokenAsync(new PlaidExchangeRequest
            {
                PublicToken = token,
                InstitutionId = instId,
                InstitutionName = instName
            });

            await Js.InvokeVoidAsync("sessionStorage.removeItem", "pf.plaid.pending");
            await Toasts.SuccessAsync("Bank linked. Transactions imported.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toasts.ErrorAsync(ex.Message);
        }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Api.GetPlaidItemsAsync(); }
        catch (Exception ex)
        {
            _items = new();
            await Toasts.ErrorAsync(ex.Message);
        }
        finally { _loading = false; }
    }

    private async Task ConnectAsync()
    {
        _busy = true;
        try
        {
            var link = await Api.CreatePlaidLinkTokenAsync();
            if (link is null || string.IsNullOrEmpty(link.LinkToken))
                throw new InvalidOperationException("Could not create Plaid link token. Is Plaid configured?");

            PlaidLinkResult? result;
            try
            {
                result = await Js.InvokeAsync<PlaidLinkResult?>("pfPlaid.open", link.LinkToken);
            }
            catch (JSDisconnectedException)
            {
                result = await Js.InvokeAsync<PlaidLinkResult?>("pfPlaid.takePending");
            }

            result ??= await Js.InvokeAsync<PlaidLinkResult?>("pfPlaid.takePending");
            if (result is null || string.IsNullOrEmpty(result.PublicToken))
            {
                await Toasts.ErrorAsync("The bank link did not finish saving. Tap Complete link or Connect bank again.");
                return;
            }

            await Api.ExchangePlaidTokenAsync(new PlaidExchangeRequest
            {
                PublicToken = result.PublicToken,
                InstitutionId = result.InstitutionId,
                InstitutionName = result.InstitutionName
            });

            await Toasts.SuccessAsync("Bank linked. Transactions imported.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toasts.ErrorAsync(ex.Message);
        }
        finally { _busy = false; }
    }

    private async Task SyncAllAsync()
    {
        _busy = true;
        try
        {
            var r = await Api.SyncAllPlaidAsync();
            await Toasts.SuccessAsync($"Synced: +{r?.TransactionsAdded ?? 0} txns");
            await LoadAsync();
        }
        catch (Exception ex) { await Toasts.ErrorAsync(ex.Message); }
        finally { _busy = false; }
    }

    private async Task SyncOneAsync(int id)
    {
        _busy = true;
        try
        {
            var r = await Api.SyncPlaidItemAsync(id);
            await Toasts.SuccessAsync($"Synced: +{r?.TransactionsAdded ?? 0} txns");
            await LoadAsync();
        }
        catch (Exception ex) { await Toasts.ErrorAsync(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RemoveAsync(int id)
    {
        if (!await Confirm.ShowAsync(
                "Disconnect this bank? Future automatic imports will stop. Existing accounts and transactions stay.",
                title: "Disconnect bank",
                confirmText: "Disconnect"))
            return;

        _busy = true;
        try
        {
            await Api.RemovePlaidItemAsync(id);
            await Toasts.SuccessAsync("Bank disconnected.");
            await LoadAsync();
        }
        catch (Exception ex) { await Toasts.ErrorAsync(ex.Message); }
        finally { _busy = false; }
    }

    private sealed class PlaidLinkResult
    {
        public string? PublicToken { get; set; }
        public string? InstitutionId { get; set; }
        public string? InstitutionName { get; set; }
    }
}