@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using PersonalFinance.Web.Models
@using PersonalFinance.Web.Services
@attribute [AllowAnonymous]
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login – Personal Finance</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <span>💰</span>
        <span>Personal Finance</span>
    </div>

    <h1>Sign in</h1>
    <p class="subtitle">Enter your credentials to access your accounts.</p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error" style="white-space:pre-wrap;">@_errorMessage</div>
    }

    <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <input id="email" class="form-control" @bind="_model.Email" autocomplete="username" data-focus-on-nav />
    </div>

    <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input id="password" type="password" class="form-control" @bind="_model.Password" autocomplete="current-password" />
    </div>

    <div class="form-group remember-row">
        <label class="remember-label" for="remember-me">
            <input id="remember-me" type="checkbox" @bind="_model.RememberMe" class="remember-check" />
            <span>Remember me</span>
        </label>
    </div>

    <button type="button" class="btn btn-primary btn-block" disabled="@_isSubmitting" @onclick="HandleLoginAsync">
        @(_isSubmitting ? "Signing in…" : "Sign in")
    </button>

    <div class="auth-footer">
        Don't have an account? <a href="/register">Create one</a>
    </div>
</div>

@code {
    private readonly LoginFormModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            var (success, error) = await Auth.LoginAsync(
                _model.Email.Trim(),
                _model.Password,
                _model.RememberMe);

            if (!success)
            {
                _errorMessage = error ?? "Login failed.";
                return;
            }

            ((ServerAuthenticationStateProvider)AuthStateProvider).NotifyAuthChanged();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            return;
        }
        finally
        {
            _isSubmitting = false;
        }

        Navigation.NavigateTo("/");
    }
}