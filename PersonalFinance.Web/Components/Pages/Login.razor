@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using PersonalFinance.Web.Models
@using PersonalFinance.Web.Services
@attribute [AllowAnonymous]
@layout AuthLayout
@inject AuthService Auth
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Login – Personal Finance</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <span>💰</span>
        <span>Personal Finance</span>
    </div>

    <h1>Sign in</h1>
    <p class="subtitle">Enter your credentials to access your accounts.</p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error" style="white-space:pre-wrap;">@_errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(_infoMessage))
    {
        <div class="auth-error" style="white-space:pre-wrap;color:#86efac;">@_infoMessage</div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="_model.Email" autocomplete="username" data-focus-on-nav />
            <ValidationMessage For="() => _model.Email" class="text-red-400" style="font-size:0.8rem;margin-top:0.25rem;" />
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
            <ValidationMessage For="() => _model.Password" class="text-red-400" style="font-size:0.8rem;margin-top:0.25rem;" />
        </div>

        <div class="form-group remember-row">
            <label class="remember-label" for="remember-me">
                <InputCheckbox id="remember-me" @bind-Value="_model.RememberMe" class="remember-check" />
                <span>Remember me</span>
            </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSubmitting">
            @(_isSubmitting ? "Signing in…" : "Sign in")
        </button>
    </EditForm>

    <div class="auth-footer">
        Don't have an account? <a href="/register">Create one</a>
    </div>
</div>

@code {
    private readonly LoginFormModel _model = new();
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _isSubmitting;

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _infoMessage = null;
        _isSubmitting = true;
        try
        {
            var (success, error) = await Auth.LoginAsync(
                _model.Email.Trim(),
                _model.Password,
                _model.RememberMe);

            if (!success)
            {
                _errorMessage = error ?? "Login failed.";
                return;
            }

            _infoMessage = "Signed in — loading dashboard…";
            StateHasChanged();

            ((ServerAuthenticationStateProvider)AuthStateProvider).NotifyAuthChanged();
            await Task.Yield();
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}