@page "/"
@attribute [Authorize]
@using PersonalFinance.Core.Dtos
@using PersonalFinance.Core.Dtos.Dashboard
@using PersonalFinance.Core.Enums
@using PersonalFinance.Web.Services
@inject FinanceApiClient Api
@rendermode InteractiveServer

<PageTitle>Dashboard</PageTitle>

<h1 class="mb-6 text-2xl font-bold text-foreground">Dashboard</h1>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading dashboard…" />
}
else if (_dashboard is null)
{
    <p class="text-foreground-muted">Could not load dashboard. Is the API running?</p>
}
else
{
    <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-border bg-surface p-5">
            <p class="text-sm text-foreground-muted">Net Worth</p>
            <p class="mt-1 text-2xl font-semibold text-foreground">@_dashboard.NetWorth.ToString("C")</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
            <p class="text-sm text-foreground-muted">Monthly Income</p>
            <p class="mt-1 text-2xl font-semibold text-success">@_dashboard.MonthlyIncome.ToString("C")</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
            <p class="text-sm text-foreground-muted">Monthly Expenses</p>
            <p class="mt-1 text-2xl font-semibold text-brand">@_dashboard.MonthlyExpenses.ToString("C")</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
            <p class="text-sm text-foreground-muted">Monthly Net</p>
            <p class="mt-1 text-2xl font-semibold @(_dashboard.MonthlyNet >= 0 ? "text-success" : "text-brand")">
                @_dashboard.MonthlyNet.ToString("C")
            </p>
        </div>
    </div>

    <h2 class="mb-4 text-lg font-semibold text-foreground">Recent Transactions</h2>
    <div class="overflow-hidden rounded-xl border border-border bg-surface">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-surface-2 text-xs uppercase tracking-wider text-foreground-muted">
                    <tr>
                        <th class="px-5 py-3">Date</th>
                        <th class="px-5 py-3">Description</th>
                        <th class="hidden px-5 py-3 md:table-cell">Account</th>
                        <th class="hidden px-5 py-3 lg:table-cell">Category</th>
                        <th class="px-5 py-3 text-right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_dashboard.RecentTransactions.Count == 0)
                    {
                        <tr><td colspan="5" class="px-5 py-8 text-center text-foreground-muted">No transactions yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var tx in _dashboard.RecentTransactions)
                        {
                            <tr class="border-t border-border hover:bg-surface-2">
                                <td class="px-5 py-3.5">@tx.Date.ToString("MMM d")</td>
                                <td class="px-5 py-3.5">@tx.Description</td>
                                <td class="hidden px-5 py-3.5 md:table-cell">@(string.IsNullOrEmpty(tx.AccountName) ? "—" : tx.AccountName)</td>
                                <td class="hidden px-5 py-3.5 lg:table-cell">
                                    @if (!string.IsNullOrEmpty(tx.CategoryName))
                                    {
                                        <span>@tx.CategoryIcon @tx.CategoryName</span>
                                    }
                                    else { <span class="text-foreground-muted">—</span> }
                                </td>
                                <td class="px-5 py-3.5 text-right font-mono @(tx.Type == TransactionType.Income ? "text-success" : "text-brand")">
                                    @(tx.Type == TransactionType.Income ? "+" : "-")@tx.Amount.ToString("C")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private DashboardDto? _dashboard;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try { _dashboard = await Api.GetDashboardAsync(); }
        catch { _dashboard = null; }
        finally { _isLoading = false; }
    }
}