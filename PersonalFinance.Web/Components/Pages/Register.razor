@page "/register"
@using PersonalFinance.Services
@using PersonalFinance.Web.Models
@attribute [AllowAnonymous]
@layout AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Register – Personal Finance</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <span>💰</span>
        <span>Personal Finance</span>
    </div>

    <h1>Create account</h1>
    <p class="subtitle">Start tracking your finances in one place.</p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error" style="white-space:pre-wrap;">@_errorMessage</div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="_model.Email" autocomplete="username" />
            <ValidationMessage For="() => _model.Email" class="text-danger" style="font-size:0.8rem;margin-top:0.25rem;" />
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="new-password" />
            <ValidationMessage For="() => _model.Password" class="text-danger" style="font-size:0.8rem;margin-top:0.25rem;" />
        </div>

        <div class="form-group">
            <label class="form-label" for="confirm">Confirm password</label>
            <InputText id="confirm" type="password" class="form-control" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger" style="font-size:0.8rem;margin-top:0.25rem;" />
        </div>

        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSubmitting">
            @(_isSubmitting ? "Creating account…" : "Create account")
        </button>
    </EditForm>

    <div class="auth-footer">
        Already have an account? <a href="/login">Sign in</a>
    </div>
</div>

@code {
    private readonly RegisterFormModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            var (success, error) = await Auth.RegisterAsync(_model.Email.Trim(), _model.Password);
            if (!success)
            {
                _errorMessage = error ?? "Registration failed.";
                return;
            }

            await Task.Yield();
            Navigation.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}