<div class="flex flex-col items-center justify-center gap-4 py-12 text-foreground-muted">
    <div class="h-9 w-9 animate-spin rounded-full border-[3px] border-border border-t-brand"></div>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <span class="text-sm">@Message</span>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; } = "Loading…";
}