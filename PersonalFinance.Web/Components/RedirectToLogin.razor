@using PersonalFinance.Web.Services
@inject NavigationManager Navigation
@inject AuthTokenStore TokenStore
@inject AuthService Auth
@inject ServerAuthenticationStateProvider AuthState
@inject IJSRuntime Js

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (relative.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith("register", StringComparison.OrdinalIgnoreCase))
            return;

        // Give JS storage time on a fresh circuit after login
        for (var i = 0; i < 8; i++)
        {
            await TokenStore.EnsureRestoredAsync();
            if (TokenStore.IsAuthenticated)
                break;
            await Auth.TryRefreshAsync();
            if (TokenStore.IsAuthenticated)
                break;
            await Task.Delay(50);
        }

        if (TokenStore.IsAuthenticated)
        {
            AuthState.NotifyAuthChanged();
            return;
        }

        var target = $"/login?returnUrl={Uri.EscapeDataString(relative)}";
        await Js.InvokeVoidAsync("eval", $"window.location.assign('{target}')");
    }
}