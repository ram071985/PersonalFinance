@using PersonalFinance.Services
@inject NavigationManager Navigation
@inject AuthTokenStore TokenStore
@inject AuthService Auth
@inject ServerAuthenticationStateProvider AuthState

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (relative.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith("register", StringComparison.OrdinalIgnoreCase))
            return;

        await TokenStore.EnsureRestoredAsync();

        if (!TokenStore.IsAuthenticated
            && !string.IsNullOrWhiteSpace(TokenStore.RefreshToken))
        {
            await Auth.TryRefreshAsync();
        }

        if (!TokenStore.IsAuthenticated)
        {
            await Task.Delay(50);
            await TokenStore.EnsureRestoredAsync();
            if (!TokenStore.IsAuthenticated
                && !string.IsNullOrWhiteSpace(TokenStore.RefreshToken))
                await Auth.TryRefreshAsync();
        }

        if (TokenStore.IsAuthenticated)
        {
            AuthState.NotifyAuthChanged();
            return;
        }

        Navigation.NavigateTo(
            $"/login?returnUrl={Uri.EscapeDataString(relative)}",
            forceLoad: false);
    }
}